{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "52744378-b7b5-49e5-a2fc-9f88c1c31674"
  },
  "newProjectRoot": "projects",
  "projects": {
    "incontro": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/incontro",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "allowedCommonJsDependencies": ["maplibre-gl"],
            "styles": [
              "node_modules/@fontsource/manrope/latin-400.css",
              "node_modules/@fontsource/manrope/latin-ext-400.css",
              "node_modules/@fontsource/manrope/latin-500.css",
              "node_modules/@fontsource/manrope/latin-ext-500.css",
              "node_modules/@fontsource/manrope/latin-600.css",
              "node_modules/@fontsource/manrope/latin-ext-600.css",
              "node_modules/@fontsource/manrope/latin-700.css",
              "node_modules/@fontsource/manrope/latin-ext-700.css",
              "node_modules/@fontsource/manrope/latin-800.css",
              "node_modules/@fontsource/manrope/latin-ext-800.css",
              "node_modules/@fontsource/trocchi/latin-400.css",
              "node_modules/@fontsource/trocchi/latin-ext-400.css",
              "node_modules/@fortawesome/fontawesome-free/css/fontawesome.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/solid.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/regular.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/brands.min.css",
              {
                "input": "node_modules/maplibre-gl/dist/maplibre-gl.css",
                "bundleName": "maplibre",
                "inject": false
              },
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "incontro:build:production"
            },
            "development": {
              "buildTarget": "incontro:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
